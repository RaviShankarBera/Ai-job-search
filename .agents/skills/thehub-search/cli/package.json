{
  "name": "thehub-cli",
  "version": "1.0.0",
  "description": "Search The Hub's public Nordic startup jobs; no credentials or runtime dependencies.",
  "type": "module",
  "bin": { "thehub-search": "src/cli.ts" },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test --timeout 30000",
    "test:live": "THEHUB_LIVE_TEST=1 bun test tests/live.test.ts --timeout 60000",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": { "typescript": "^5.4.0", "@types/bun": "1.3.14" }
}
